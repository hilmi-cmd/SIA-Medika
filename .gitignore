# ==========================================
# SIA MEDIKA - .gitignore
# ==========================================

# 1. Konfigurasi Lingkungan & Kredensial Sensitif (PENTING!)
# Jika Anda nanti memindahkan URL/API Key Supabase ke file .env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Direktori Dependensi Node.js (jika menggunakan npm/Node di masa depan)
node_modules/
jspm_packages/

# 3. File Log & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs
*.log

# 4. File Editor & IDE (Visual Studio Code, Notepad++, dll.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 5. File Sampah Sistem Operasi
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS / Linux
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 6. File Build / Hasil Kompilasi (jika ada)
dist/
build/
out/
.cache/
